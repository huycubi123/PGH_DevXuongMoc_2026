@model IEnumerable<PGH_DevXuongMoc_2026.Models.Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 text-primary font-weight-bold mb-0">Quản lý danh mục</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="table-light">
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Slug)</th>
                            <th class="text-center">Icon</th>
                            <th class="text-center">Thứ tự</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Ngày tạo</th>
                            <th>Người tạo</th>
                            <th class="text-center">Cập nhật</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-3 text-muted">Chưa có dữ liệu danh mục.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Name</td>
                                    <td><code>@item.Slug</code></td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.IconPath))
                                        {
                                            <img src="~/@item.IconPath" alt="@item.Name" class="img-thumbnail" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.SortOrder</td>
                                    <td class="text-center">
                                        @if (item.IsVisible)
                                        {
                                            <span class="badge bg-success">Hiển thị</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ẩn</span>
                                        }
                                    </td>
                                    <td class="text-center small text-muted">
                                        @item.CreatedAt.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="small">@(item.CreatedBy ?? "-")</td>
                                    <td class="text-center small text-muted">
                                        @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">Sửa</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Xem</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>