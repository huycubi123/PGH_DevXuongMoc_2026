@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Chi tiết sản phẩm đầy đủ";
    Layout = "_LayoutAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-primary"><i class="bi bi-info-circle"></i> Chi tiết sản phẩm đầy đủ</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Product.Id" class="btn btn-primary me-1"><i class="bi bi-pencil"></i> Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
    </div>
</div>
<hr />

<div class="row">
    <!-- CỘT TRÁI: THÔNG TIN CHÍNH VÀ CÁC THÔNG SỐ CHI TIẾT -->
    <div class="col-md-8">
        <!-- 1. THÔNG TIN CƠ BẢN -->
        <div class="card mb-3 border-primary">
            <div class="card-header bg-primary text-white fw-bold">
                1. Thông tin cơ bản & SEO
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">ID Sản phẩm:</dt>
                    <dd class="col-sm-9 fw-bold">#@Model.Product.Id</dd>

                    <dt class="col-sm-3 text-muted">Tên sản phẩm:</dt>
                    <dd class="col-sm-9 fs-5 text-dark fw-bold">@Model.Product.Name</dd>

                    <dt class="col-sm-3 text-muted">Danh mục:</dt>
                    <dd class="col-sm-9"><span class="badge bg-info text-dark">@Model.Product.Category?.Name</span></dd>

                    <dt class="col-sm-3 text-muted">Slug SEO:</dt>
                    <dd class="col-sm-9"><code>@Model.Product.Slug</code></dd>

                    <dt class="col-sm-3 text-muted">Mô tả ngắn:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Product.ShortDescription) ? "-" : Model.Product.ShortDescription)</dd>

                    <dt class="col-sm-3 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Product.Status == 1)
                        {
                            <span class="badge bg-success">Hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Tạm ẩn</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Sản phẩm nổi bật:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Product.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> Nổi bật trang chủ</span>
                        }
                        else
                        {
                            <span class="text-muted">Không</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Lượt xem (View):</dt>
                    <dd class="col-sm-9"><span class="badge bg-light text-dark border">@Model.Product.ViewCount lượt xem</span></dd>

                    <dt class="col-sm-3 text-muted">Đánh giá (Rating):</dt>
                    <dd class="col-sm-9"><span class="text-warning font-weight-bold">@Model.Product.Rating <i class="bi bi-star-fill"></i></span></dd>
                </dl>
            </div>
        </div>

        <!-- 2. THÔNG SỐ KỸ THUẬT & CHÍNH SÁCH -->
        <div class="card mb-3 border-secondary">
            <div class="card-header bg-light fw-bold text-secondary">
                2. Thông số kỹ thuật & Chính sách dịch vụ
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Thông số tóm tắt (ShortSpec):</dt>
                    <dd class="col-sm-8 fw-bold">@(string.IsNullOrEmpty(Model.Product.ShortSpec) ? "-" : Model.Product.ShortSpec)</dd>

                    <dt class="col-sm-4 text-muted">Thông số chi tiết (Spec HTML):</dt>
                    <dd class="col-sm-8 border p-2 rounded bg-light">
                        @if (!string.IsNullOrEmpty(Model.Product.Spec))
                        {
                            @Html.Raw(Model.Product.Spec)
                        }
                        else
                        {
                            <span class="text-muted italic">Chưa nhập thông số chi tiết</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted mt-2">Bảo hành (tháng):</dt>
                    <dd class="col-sm-8 mt-2"><span class="badge bg-primary">@Model.Product.WarrantyMonths tháng</span></dd>

                    <dt class="col-sm-4 text-muted">Chính sách bảo hành (Warranty):</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Product.Warranty) ? "-" : Model.Product.Warranty)</dd>

                    <dt class="col-sm-4 text-muted">Hướng dẫn bảo quản (Care):</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Product.Care) ? "-" : Model.Product.Care)</dd>

                    <dt class="col-sm-4 text-muted">Cam kết chất lượng (Commitment):</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Product.Commitment) ? "-" : Model.Product.Commitment)</dd>

                    <dt class="col-sm-4 text-muted">Tính năng nổi bật (Features):</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Product.Features) ? "-" : Model.Product.Features)</dd>
                </dl>
            </div>
        </div>

        <!-- 3. BIẾN THỂ CHẤT LIỆU & GIÁ BÁN -->
        <div class="card mb-3 border-secondary">
            <div class="card-header bg-light fw-bold text-secondary">
                3. Danh sách Biến thể chất liệu & Giá bán
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Tên chất liệu / Biến thể</th>
                            <th>Giá gốc (OriginalPrice)</th>
                            <th>Giá bán thực tế (SalePrice)</th>
                            <th>Mặc định</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Variants != null && Model.Variants.Any())
                        {
                            int idx = 1;
                            foreach (var v in Model.Variants)
                            {
                                <tr>
                                    <td>@(idx++)</td>
                                    <td class="fw-bold text-dark">@v.MaterialName</td>
                                    <td class="text-muted text-decoration-line-through">@v.OriginalPrice.ToString("N0") VNĐ</td>
                                    <td class="text-danger fw-bold">@v.SalePrice.ToString("N0") VNĐ</td>
                                    <td>
                                        @if (v.IsDefault)
                                        {
                                            <span class="badge bg-success">Mặc định</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Sản phẩm chưa có biến thể giá</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: ALBUM ẢNH VÀ THÔNG TIN AUDIT HỆ THỐNG -->
    <div class="col-md-4">
        <!-- 4. ALBUM HÌNH ẢNH SẢN PHẨM -->
        <div class="card mb-3 border-secondary">
            <div class="card-header bg-light fw-bold text-secondary">
                <i class="bi bi-images"></i> Album hình ảnh sản phẩm (@(Model.Images?.Count ?? 0) ảnh)
            </div>
            <div class="card-body">
                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var img in Model.Images)
                        {
                            <div class="position-relative border rounded p-1 bg-white">
                                <img src="~/@img.Path" alt="@img.AltText" style="width: 100px; height: 100px; object-fit: cover;" class="rounded" />
                                @if (img.IsPrimary)
                                {
                                    <span class="badge bg-success position-absolute top-0 start-0 m-1">Ảnh chính</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary position-absolute top-0 start-0 m-1">Ảnh phụ</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">Chưa có hình ảnh nào</div>
                }
            </div>
        </div>

        <!-- 5. THÔNG TIN AUDIT HỆ THỐNG (CREATED/UPDATED) -->
        <div class="card mb-3 border-info">
            <div class="card-header bg-info text-dark fw-bold">
                <i class="bi bi-shield-check"></i> Nhật ký hệ thống (Audit Info)
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Ngày tạo:</dt>
                    <dd class="col-sm-7">@Model.Product.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                    <dt class="col-sm-5 text-muted">Người tạo:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(Model.Product.CreatedBy) ? "Admin" : Model.Product.CreatedBy)</span></dd>

                    <dt class="col-sm-5 text-muted">Cập nhật lần cuối:</dt>
                    <dd class="col-sm-7">
                        @if (Model.Product.UpdatedAt.HasValue)
                        {
                            @Model.Product.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss")
                        }
                        else
                        {
                            <span class="text-muted">Chưa cập nhật</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">Người cập nhật:</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrEmpty(Model.Product.UpdatedBy))
                        {
                            <span class="badge bg-light text-dark border">@Model.Product.UpdatedBy</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">Đã bị xóa (IsDeleted):</dt>
                    <dd class="col-sm-7">
                        @if (Model.Product.IsDeleted)
                        {
                            <span class="badge bg-danger">Đã xóa mềm</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Đang hoạt động</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>