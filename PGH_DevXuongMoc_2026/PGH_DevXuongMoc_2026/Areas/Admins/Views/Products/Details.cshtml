@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Details";
    Layout = "_LayoutAdmin";
}

<h1>Details</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>

        <dt class="col-sm-2">Hình ảnh</dt>
        <dd class="col-sm-10">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var img in Model.Images)
                {
                    <img src="~/@img.Path" style="width: 80px; height: 80px; object-fit: cover;" class="border" />
                }
            </div>
        </dd>

        <dt class="col-sm-2">Biến thể & Giá</dt>
        <dd class="col-sm-10">
            <ul>
                @foreach (var v in Model.Variants)
                {
                    <li>@v.MaterialName: <strong>@v.SalePrice.ToString("N0") đ</strong> (Giá gốc: <del>@v.OriginalPrice.ToString("N0") đ</del>)</li>
                }
            </ul>
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Slug)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Slug)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.ShortDescription)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.ShortDescription)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Spec)</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Product.Spec)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Care)</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Product.Care)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Warranty)</dt>
        <dd class="col-sm-10">@Html.Raw(Model.Product.Warranty)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.WarrantyMonths)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.WarrantyMonths)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Category)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Category.Name)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Product.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>