@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
    Layout = "_LayoutAdmin";
}

<h1 class="text-primary">Thêm mới sản phẩm</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Danh mục sản phẩm <span class="text-danger">*</span></label>
                    <select asp-for="Product.CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="Product.CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="Product.Name" class="form-control" placeholder="VD: Bàn ăn gỗ Sồi Nga 6 ghế" />
                    <span asp-validation-for="Product.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Đường dẫn SEO (Slug)</label>
                <input asp-for="Product.Slug" class="form-control" placeholder="VD: ban-an-go-soi-nga-6-ghe (Tự động tạo nếu để trống)" />
            </div>

            <!-- KHỐI QUẢN LÝ ẢNH (HTML THUẦN) -->
            <div class="card mb-3 border-secondary">
                <div class="card-header bg-light fw-bold text-primary">
                    <i class="bi bi-images"></i> Quản lý hình ảnh sản phẩm
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">1. Ảnh đại diện chính (Primary Image)</label>
                        <input type="file" name="primaryImageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold">2. Album ảnh phụ chi tiết (Secondary Images)</label>
                        <input type="file" name="secondaryImageFiles" class="form-control" accept="image/*" multiple />
                        <div class="form-text text-danger fw-bold">
                            * Lưu ý: Giữ phím Ctrl hoặc Shift để quét chọn tất cả các ảnh phụ cùng lúc trong 1 lần mở hộp thoại.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3 border-secondary">
                <div class="card-header bg-light fw-bold">Biến thể chất liệu & Giá bán</div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <label class="form-label small">Tên chất liệu / Biến thể</label>
                            <input type="text" name="Variants[0].MaterialName" class="form-control" placeholder="VD: Gỗ Sồi tự nhiên" value="Gỗ tự nhiên" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Giá gốc (VNĐ)</label>
                            <input type="number" name="Variants[0].OriginalPrice" class="form-control" value="2000000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Giá bán thực tế (VNĐ)</label>
                            <input type="number" name="Variants[0].SalePrice" class="form-control" value="1500000" />
                            <span asp-validation-for="Variants[0].SalePrice" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả ngắn</label>
                <input asp-for="Product.ShortDescription" class="form-control" placeholder="Mô tả tóm tắt..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Thông số kỹ thuật tóm tắt</label>
                <input asp-for="Product.ShortSpec" class="form-control" placeholder="VD: D160 x R80 x C75 (cm)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Thông số chi tiết (HTML)</label>
                <textarea asp-for="Product.Spec" class="form-control" rows="3" placeholder="Nội dung thông số..."></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Hướng dẫn bảo quản</label>
                    <input asp-for="Product.Care" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Chính sách bảo hành</label>
                    <input asp-for="Product.Warranty" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Cam kết chất lượng</label>
                    <input asp-for="Product.Commitment" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tính năng nổi bật</label>
                    <input asp-for="Product.Features" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Bảo hành (tháng)</label>
                    <input asp-for="Product.WarrantyMonths" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Đánh giá (Rating)</label>
                    <input asp-for="Product.Rating" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Trạng thái hiển thị</label>
                    <select asp-for="Product.Status" class="form-select">
                        <option value="1">Hiển thị</option>
                        <option value="0">Ẩn (Tạm ẩn sản phẩm)</option>
                    </select>
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Product.IsFeatured" id="isFeaturedCheck" />
                <label class="form-check-label fw-bold" for="isFeaturedCheck">
                    Đánh dấu là Sản phẩm nổi bật trang chủ
                </label>
            </div>

            <div class="mt-4 mb-5">
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Tạo sản phẩm</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}