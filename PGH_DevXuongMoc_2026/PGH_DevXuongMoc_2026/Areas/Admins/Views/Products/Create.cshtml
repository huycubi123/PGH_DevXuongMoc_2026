@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Create";
    Layout = "_LayoutAdmin";
}

<h1>Create</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Product.CategoryId" class="control-label"></label>
                <select asp-for="Product.CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Product.Name" class="control-label"></label>
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Slug" class="control-label"></label>
                <input asp-for="Product.Slug" class="form-control" />
                <span asp-validation-for="Product.Slug" class="text-danger"></span>
            </div>

            <!-- TẢI ẢNH LÊN -->
            <div class="form-group border p-2 my-2">
                <label class="control-label fw-bold">Ảnh đại diện chính (Primary Image)</label>
                <input type="file" asp-for="PrimaryImageFile" class="form-control" accept="image/*" />
            </div>
            <div class="form-group border p-2 my-2">
                <label class="control-label fw-bold">Các ảnh phụ bổ sung (Secondary Images)</label>
                <input type="file" asp-for="SecondaryImageFiles" class="form-control" accept="image/*" multiple />
            </div>

            <!-- NHẬP BIẾN THỂ (GIÁ & CHẤT LIỆU) -->
            <div class="form-group border p-2 my-2">
                <label class="control-label fw-bold">Chất liệu & Giá bán (ProductVariant)</label>
                <div id="variantList">
                    <div class="row mb-2">
                        <div class="col-5">
                            <input type="text" name="Variants[0].MaterialName" class="form-control" placeholder="Tên chất liệu (VD: Gỗ Sồi)" required />
                        </div>
                        <div class="col-3">
                            <input type="number" name="Variants[0].OriginalPrice" class="form-control" placeholder="Giá gốc" value="0" required />
                        </div>
                        <div class="col-4">
                            <input type="number" name="Variants[0].SalePrice" class="form-control" placeholder="Giá bán" value="0" required />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Product.ShortDescription" class="control-label"></label>
                <input asp-for="Product.ShortDescription" class="form-control" />
                <span asp-validation-for="Product.ShortDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.ShortSpec" class="control-label"></label>
                <input asp-for="Product.ShortSpec" class="form-control" />
                <span asp-validation-for="Product.ShortSpec" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Spec" class="control-label"></label>
                <input asp-for="Product.Spec" class="form-control" />
                <span asp-validation-for="Product.Spec" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Care" class="control-label"></label>
                <input asp-for="Product.Care" class="form-control" />
                <span asp-validation-for="Product.Care" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Warranty" class="control-label"></label>
                <input asp-for="Product.Warranty" class="form-control" />
                <span asp-validation-for="Product.Warranty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Commitment" class="control-label"></label>
                <input asp-for="Product.Commitment" class="form-control" />
                <span asp-validation-for="Product.Commitment" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Features" class="control-label"></label>
                <input asp-for="Product.Features" class="form-control" />
                <span asp-validation-for="Product.Features" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.WarrantyMonths" class="control-label"></label>
                <input asp-for="Product.WarrantyMonths" class="form-control" />
                <span asp-validation-for="Product.WarrantyMonths" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Rating" class="control-label"></label>
                <input asp-for="Product.Rating" class="form-control" />
                <span asp-validation-for="Product.Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Status" class="control-label"></label>
                <input asp-for="Product.Status" class="form-control" />
                <span asp-validation-for="Product.Status" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Product.IsFeatured" /> @Html.DisplayNameFor(model => model.Product.IsFeatured)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Product.ViewCount" class="control-label"></label>
                <input asp-for="Product.ViewCount" class="form-control" />
                <span asp-validation-for="Product.ViewCount" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Product.IsDeleted" /> @Html.DisplayNameFor(model => model.Product.IsDeleted)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Product.CreatedBy" class="control-label"></label>
                <input asp-for="Product.CreatedBy" class="form-control" />
                <span asp-validation-for="Product.CreatedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.UpdatedAt" class="control-label"></label>
                <input asp-for="Product.UpdatedAt" class="form-control" />
                <span asp-validation-for="Product.UpdatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.UpdatedBy" class="control-label"></label>
                <input asp-for="Product.UpdatedBy" class="form-control" />
                <span asp-validation-for="Product.UpdatedBy" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}