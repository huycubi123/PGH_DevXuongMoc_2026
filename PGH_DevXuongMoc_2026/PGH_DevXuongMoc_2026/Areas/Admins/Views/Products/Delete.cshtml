@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Xóa sản phẩm";
    Layout = "_LayoutAdmin";
}

<h1 class="text-danger">Xóa sản phẩm</h1>
<h4 class="text-warning">Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này cùng toàn bộ hình ảnh và biến thể?</h4>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3 fw-bold">Tên sản phẩm</dt>
        <dd class="col-sm-9 fw-bold">@Model.Product.Name</dd>

        <dt class="col-sm-3 fw-bold">Danh mục</dt>
        <dd class="col-sm-9">@Model.Product.Category?.Name</dd>

        <dt class="col-sm-3 fw-bold">Số lượng ảnh sẽ xóa</dt>
        <dd class="col-sm-9 text-danger fw-bold">@Model.Images.Count file ảnh</dd>

        <dt class="col-sm-3 fw-bold">Số lượng biến thể sẽ xóa</dt>
        <dd class="col-sm-9 text-danger fw-bold">@Model.Variants.Count biến thể giá</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Product.Id" />
        <button type="submit" class="btn btn-danger px-4">Xác nhận Xóa</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy bỏ</a>
    </form>
</div>