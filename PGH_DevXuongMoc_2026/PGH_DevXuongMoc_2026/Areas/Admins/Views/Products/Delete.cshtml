@model PGH_DevXuongMoc_2026.Models.ProductManageVM

@{
    ViewData["Title"] = "Delete";
    Layout = "_LayoutAdmin";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Slug)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Slug)</dd>

        <dt class="col-sm-2">Số lượng ảnh sẽ xóa</dt>
        <dd class="col-sm-10">@Model.Images.Count ảnh</dd>

        <dt class="col-sm-2">Số lượng biến thể sẽ xóa</dt>
        <dd class="col-sm-10">@Model.Variants.Count biến thể</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Product.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>